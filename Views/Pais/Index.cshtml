@{
    ViewData["Title"] = "Consumo de API REST Countries";
}

<div class="page-header">
    <div>
        <h2>Consumo de API REST Countries</h2>
        <p class="subtitle">ASP.NET Core MVC + Entity Framework Core + SQL Server</p>
    </div>
    <div>
        <a asp-action="Lista" class="btn btn-outline-dark">Ver listado</a>
        <a asp-action="Reportes" class="btn btn-outline-primary">Reportes</a>
    </div>
</div>

<div class="app-card">
    <h5>Importar todos los países</h5>
    <p class="text-muted mb-3">Descarga la información desde la API y la guarda en la base de datos.</p>
    <a asp-action="Importar" class="btn btn-success">Importar información</a>
</div>

<div class="app-card">
    <h5>Importar un país por nombre </h5>
    <form asp-action="Buscar" method="post" class="row g-2">
        <div class="col-12 col-sm">
            <input type="text" name="nombre" class="form-control" placeholder="Ej: ecuador" />
        </div>
        <div class="col-12 col-sm-auto">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
    </form>
</div>
