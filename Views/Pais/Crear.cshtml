@model ApiPaisesMVC_SQLServer.Models.Pais
@{
    ViewData["Title"] = "Agregar País";
}

<h2>Agregar País</h2>
<hr />

<div class="col-md-6">
    <form asp-action="Crear" method="post">
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Capital" class="form-label">Capital</label>
            <input asp-for="Capital" class="form-control" />
            <span asp-validation-for="Capital" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Region" class="form-label">Región</label>
            <input asp-for="Region" class="form-control" />
            <span asp-validation-for="Region" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SubRegion" class="form-label">Subregión</label>
            <input asp-for="SubRegion" class="form-control" />
            <span asp-validation-for="SubRegion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Poblacion" class="form-label">Población</label>
            <input asp-for="Poblacion" class="form-control" />
            <span asp-validation-for="Poblacion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Area" class="form-label">Área</label>
            <input asp-for="Area" class="form-control" />
            <span asp-validation-for="Area" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Moneda" class="form-label">Moneda</label>
            <input asp-for="Moneda" class="form-control" />
            <span asp-validation-for="Moneda" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Lista" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
