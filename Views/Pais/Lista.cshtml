@model IEnumerable<ApiPaisesMVC_SQLServer.Models.Pais>
@{
    ViewData["Title"] = "Listado de Países";
    var regiones = ViewBag.Regiones as List<string> ?? new List<string>();
}

<div class="page-header">
    <div>
        <h2>Listado de Países</h2>
        <p class="subtitle">@Model.Count() resultado(s)</p>
    </div>
    <div>
        <a asp-action="Crear" class="btn btn-success">+ Agregar país</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Inicio</a>
    </div>
</div>

<div class="app-card">
    <!-- Buscar por nombre: primero en SQL Server y, si no hay datos, en la API -->
    <form asp-action="Buscar" method="post" class="row g-2 mb-3">
        <div class="col-12 col-sm">
            <input type="text" name="nombre" class="form-control" placeholder="Buscar país (BD y API)" />
        </div>
        <div class="col-12 col-sm-auto">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
    </form>

    <!-- Actividad 3 (búsquedas) y Actividad 4 (filtro por región) -->
    <form asp-action="Lista" method="get" class="row g-2">
        <div class="col-12 col-md-3">
            <input type="text" name="nombre" value="@ViewBag.Nombre" class="form-control" placeholder="Nombre" />
        </div>
        <div class="col-12 col-md-3">
            <input type="text" name="capital" value="@ViewBag.Capital" class="form-control" placeholder="Capital" />
        </div>
        <div class="col-12 col-md-3">
            <select name="region" class="form-select">
                <option value="">-- Todas las regiones --</option>
                @foreach (var r in regiones)
                {
                    if ((string?)ViewBag.Region == r)
                    {
                        <option value="@r" selected>@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filtrar</button>
            <a asp-action="Lista" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="table-wrap">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Capital</th>
                <th>Región</th>
                <th>Subregión</th>
                <th class="num">Población</th>
                <th class="num">Área</th>
                <th>Moneda</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Nombre</td>
                    <td>@item.Capital</td>
                    <td><span class="badge text-bg-primary-subtle text-primary-emphasis">@item.Region</span></td>
                    <td>@item.SubRegion</td>
                    <td class="num">@($"{item.Poblacion:N0}")</td>
                    <td class="num">@($"{item.Area:N0}")</td>
                    <td>@item.Moneda</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="empty-state">No hay países para mostrar. Prueba otros filtros o importa información.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Vaciar la tabla: requiere escribir "eliminar" -->
<div class="app-card mt-4">
    <h5 class="text-danger">Zona de peligro</h5>
    <form asp-action="Vaciar" method="post" class="row g-2">
        <div class="col-12 col-sm-auto">
            <input type="text" name="confirmacion" class="form-control" placeholder='Escribe "eliminar"' autocomplete="off" />
        </div>
        <div class="col-12 col-sm-auto">
            <button type="submit" class="btn btn-outline-danger">Vaciar base de datos</button>
        </div>
    </form>
</div>
