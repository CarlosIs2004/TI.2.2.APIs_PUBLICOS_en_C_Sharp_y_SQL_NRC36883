@model ApiPaisesMVC_SQLServer.Models.Pais
@{
    ViewData["Title"] = "Eliminar País";
}

<h2>Eliminar País</h2>
<hr />
<p>¿Está seguro de que desea eliminar este país?</p>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Capital</dt>
    <dd class="col-sm-10">@Model.Capital</dd>
    <dt class="col-sm-2">Región</dt>
    <dd class="col-sm-10">@Model.Region</dd>
    <dt class="col-sm-2">Población</dt>
    <dd class="col-sm-10">@Model.Poblacion</dd>
</dl>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Lista" class="btn btn-secondary">Cancelar</a>
</form>
