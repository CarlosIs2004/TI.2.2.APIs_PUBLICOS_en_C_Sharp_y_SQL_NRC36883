@model ApiPaisesMVC_SQLServer.Models.Universidad
@{
    ViewData["Title"] = "Eliminar Universidad";
}

<h2>Eliminar Universidad</h2>
<hr />
<p>¿Está seguro de que desea eliminar esta universidad?</p>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Dominio</dt>
    <dd class="col-sm-10">@Model.Dominio</dd>
    <dt class="col-sm-2">Sitio Web</dt>
    <dd class="col-sm-10">@Model.SitioWeb</dd>
    <dt class="col-sm-2">País</dt>
    <dd class="col-sm-10">@Model.Pais</dd>
</dl>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Lista" class="btn btn-secondary">Cancelar</a>
</form>
